cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED PB_SOURCE_DIR OR NOT DEFINED PB_TEST_BINARY_DIR)
    message(FATAL_ERROR "PB_SOURCE_DIR and PB_TEST_BINARY_DIR are required")
endif()

include("${PB_SOURCE_DIR}/fuzz/prepare_mutation_corpus.cmake")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef probeId)
set(probeRoot "${PB_TEST_BINARY_DIR}/fuzz-corpus-${probeId}")
set(seedDirectory "${probeRoot}/source-seeds")
set(mutationDirectory "${probeRoot}/build-mutations")
file(MAKE_DIRECTORY "${seedDirectory}")
file(WRITE "${seedDirectory}/seed.bin" "independent frozen seed\n")
file(SHA256 "${seedDirectory}/seed.bin" originalHash)

if(PB_REJECT_ALIAS)
    PbPrepareMutationCorpus("${seedDirectory}" "${seedDirectory}")
    message(STATUS "Unsafe source destination was accepted")
    return()
endif()

PbPrepareMutationCorpus("${seedDirectory}" "${mutationDirectory}")
file(SHA256 "${mutationDirectory}/seed.bin" copiedHash)
if(NOT copiedHash STREQUAL originalHash)
    message(FATAL_ERROR "The writable corpus did not receive the original seed")
endif()
file(WRITE "${mutationDirectory}/seed.bin" "mutated copy\n")
file(WRITE "${mutationDirectory}/new-discovery" "new input\n")
file(SHA256 "${seedDirectory}/seed.bin" preservedHash)
if(NOT preservedHash STREQUAL originalHash OR EXISTS "${seedDirectory}/new-discovery")
    message(FATAL_ERROR "Mutation output changed the original corpus")
endif()
PbPrepareMutationCorpus("${seedDirectory}" "${mutationDirectory}")
file(SHA256 "${mutationDirectory}/seed.bin" refreshedHash)
if(NOT refreshedHash STREQUAL originalHash OR NOT EXISTS "${mutationDirectory}/new-discovery")
    message(FATAL_ERROR "Reconfiguration lost seeds or erased prior discoveries")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" "-DPB_SOURCE_DIR=${PB_SOURCE_DIR}"
    "-DPB_TEST_BINARY_DIR=${PB_TEST_BINARY_DIR}" -DPB_REJECT_ALIAS=ON -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE rejectionResult OUTPUT_VARIABLE rejectionOutput ERROR_VARIABLE rejectionError)
if(rejectionResult EQUAL 0 OR NOT "${rejectionError}" MATCHES "must be outside the source seed directory")
    message(FATAL_ERROR "Unsafe source/destination alias was not rejected: ${rejectionOutput}${rejectionError}")
endif()

file(READ "${PB_SOURCE_DIR}/fuzz/CMakeLists.txt" fuzzCmake)
string(REGEX MATCHALL "add_test\\([^)]*\\)" registrations "${fuzzCmake}")
set(mutationRegistrationCount 0)
foreach(registration IN LISTS registrations)
    if(registration MATCHES "-runs=" AND registration MATCHES "(corpus/|pbFuzzMutationCorpusRoot)")
        if(NOT registration MATCHES "\\$\\{pbFuzzMutationCorpusRoot\\}/")
            message(FATAL_ERROR "libFuzzer smoke must use its isolated mutation corpus: ${registration}")
        endif()
        math(EXPR mutationRegistrationCount "${mutationRegistrationCount} + 1")
    endif()
endforeach()
if(NOT mutationRegistrationCount EQUAL 10)
    message(FATAL_ERROR "Expected all ten seeded protocol/FEC/raster smoke registrations")
endif()
