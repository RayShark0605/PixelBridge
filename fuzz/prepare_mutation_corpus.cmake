function(PbPrepareMutationCorpus sourceDirectory destinationDirectory)
    file(REAL_PATH "${sourceDirectory}" seedRoot)
    get_filename_component(mutationRoot "${destinationDirectory}" ABSOLUTE)
    if(EXISTS "${mutationRoot}")
        file(REAL_PATH "${mutationRoot}" mutationRoot)
    endif()
    cmake_path(IS_PREFIX seedRoot "${mutationRoot}" NORMALIZE destinationInsideSource)
    if(destinationInsideSource)
        message(FATAL_ERROR "The mutation corpus must be outside the source seed directory")
    endif()
    file(GLOB seeds "${seedRoot}/*.bin")
    if(NOT seeds)
        message(FATAL_ERROR "No frozen binary seeds were found in ${seedRoot}")
    endif()
    file(MAKE_DIRECTORY "${mutationRoot}")
    # Refresh the named seeds without deleting coverage discoveries from an
    # earlier run. libFuzzer may modify only this build-tree copy.
    foreach(seed IN LISTS seeds)
        get_filename_component(seedName "${seed}" NAME)
        file(COPY_FILE "${seed}" "${mutationRoot}/${seedName}" ONLY_IF_DIFFERENT)
    endforeach()
endfunction()
